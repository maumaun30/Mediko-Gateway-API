# ─────────────────────────────────────────────────────────────────────────────
# Secrets and infrastructure ONLY.
# Everyday settings (notification emails, SMS on/off, sender name, send
# delays) and message templates are edited in the admin portal and saved in
# the DB. See the bottom of this file for the optional .env fallbacks.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001

# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Email (Brevo SMTP). MAIL_FROM must be a sender verified in Brevo.
BREVO_USER=your_brevo_email
BREVO_PASS=your_brevo_smtp_key
MAIL_FROM=no-reply@mediko.ph

# Admin portal auth. The portal only works inside the Shopify admin: it trades
# a verified Shopify session token for a 15-minute dashboard JWT signed with
# this secret. Must be 32+ random characters (admin routes return 503 without
# it). Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DASHBOARD_JWT_SECRET=

# Origins allowed to call the API (storefront + Shopify admin embed)
ALLOWED_ORIGINS='https://store.mediko.ph,https://mediko.ph'

# Public URL of this gateway, used for unsubscribe links and the webhook URL
# shown in the portal. Falls back to the host of the admin request.
PUBLIC_BASE_URL=https://mediko-gateway.quailshack.com

# Shopify Admin API
# Scopes are declared in shopify.app.toml and released with `shopify app deploy`:
#   read_customers, write_customers, read_orders, write_orders, read_fulfillments
# Check what the token below actually carries: GET /api/shopify/scopes
# Exact *.myshopify.com domain. Also pins admin sign-in to this store.
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_API_VERSION=2026-04

# Authenticate one of two ways.
#
# Preferred — the app mints its own token via the client credentials grant and
# refreshes it before expiry. Scope changes take effect without touching .env.
# SHOPIFY_CLIENT_SECRET also verifies webhooks declared in shopify.app.toml and
# the admin's session tokens. SHOPIFY_CLIENT_ID falls back to shopify.app.toml.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
# Or paste a long-lived install token. If set, this WINS over the client
# credentials above. Do not paste a token obtained from the client credentials
# grant here — those expire after 24 hours and will not be refreshed.
SHOPIFY_ADMIN_TOKEN=

# Only needed if the fulfillment webhook was created in Shopify admin
# (Settings > Notifications > Webhooks) instead of shopify.app.toml.
SHOPIFY_WEBHOOK_SECRET=

# SMS via Semaphore (semaphore.co) — shipping texts and SMS blasts.
SEMAPHORE_API_KEY=

# Image optimizer service — converts uploaded ID/return photos to WebP
# (1200px max width) before they're stored in ./uploads. If unset or
# unreachable, originals are kept and the upload still succeeds.
IMAGE_OPTIMIZER_URL=https://image-optimizer.quailshack.com

# Set to "true" to disable rate limiter, time-trap, and submission cooldown
# on form endpoints (apply / contact / returns). Local + staging only — NEVER in prod.
TESTING_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Optional fallbacks for portal Settings. Used only until a value is saved in
# the portal; a saved value always wins. New installs can leave these out.
# ─────────────────────────────────────────────────────────────────────────────
# ADMIN_EMAIL=admin@mediko.ph
# ADMIN_CC=manager@mediko.ph,billing@mediko.ph
# BLAST_SEND_DELAY_MS=300
# SMS_SHIPPING_ENABLED=true
# SEMAPHORE_SENDER_NAME=
# SMS_BLAST_DELAY_MS=600
